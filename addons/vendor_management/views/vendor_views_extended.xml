<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Updated Vendor Form View with All New Features -->
    <record id="view_vendor_form_extended" model="ir.ui.view">
        <field name="name">vendor.vendor.form.extended</field>
        <field name="model">vendor.vendor</field>
        <field name="inherit_id" ref="vendor_management.view_vendor_form"/>
        <field name="arch" type="xml">
            <!-- Update Header Buttons -->
            <xpath expr="//header/button[@name='action_set_active']" position="before">
                <button name="action_submit_for_approval" string="Submit for Approval" type="object"
                        invisible="status not in ['draft', 'potential']" class="oe_highlight"/>
                <button name="action_approve" string="Approve" type="object"
                        invisible="status != 'pending_approval'" class="oe_highlight"
                        groups="vendor_management.group_vendor_manager"/>
                <button name="action_reject" string="Reject" type="object"
                        invisible="status != 'pending_approval'"
                        groups="vendor_management.group_vendor_manager"/>
            </xpath>

            <!-- Update Status Bar -->
            <field name="status" position="attributes">
                <attribute name="statusbar_visible">draft,pending_approval,approved,active</attribute>
            </field>

            <!-- Add More Stat Buttons -->
            <button name="action_view_ratings" position="after">
                <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="document_ids" widget="statinfo" string="Documents"/>
                        </span>
                    </div>
                </button>
                <button name="action_view_rfqs" type="object" class="oe_stat_button" icon="fa-question-circle">
                    <field name="rfq_count" widget="statinfo" string="RFQs"/>
                </button>
                <button name="action_view_pos" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                    <field name="po_count" widget="statinfo" string="POs"/>
                </button>
                <button name="action_view_ncrs" type="object" class="oe_stat_button" icon="fa-warning">
                    <field name="ncr_count" widget="statinfo" string="NCRs"/>
                </button>
            </button>

            <!-- Update Basic Information Group -->
            <field name="date_joined" position="after">
                <field name="vendor_classification" readonly="1"/>
                <field name="onboarding_state"/>
            </field>

            <!-- Update Rating Information Group -->
            <field name="rating_count" position="after">
                <field name="quality_score" widget="progressbar"/>
                <field name="delivery_score" widget="progressbar"/>
            </field>

            <!-- Add Compliance & Certifications Tab Before Business Info -->
            <page string="Business Information" position="before">
                <page string="Compliance &amp; Certifications" name="compliance">
                    <group>
                        <group string="Legal Documents">
                            <field name="gst_number"/>
                            <field name="pan_number"/>
                        </group>
                        <group string="ISO Certification">
                            <field name="iso_certified"/>
                            <field name="iso_certificate_number" invisible="not iso_certified"/>
                            <field name="iso_valid_until" invisible="not iso_certified"/>
                        </group>
                    </group>
                    <group string="Capabilities">
                        <field name="capabilities" placeholder="Products/services offered, technical capabilities..."/>
                        <group>
                            <field name="production_capacity"/>
                            <field name="lead_time_days"/>
                        </group>
                    </group>
                </page>
            </page>

            <!-- Add Documents Tab After Business Info -->
            <page string="Business Information" position="after">
                <page string="Documents" name="documents">
                    <field name="document_ids">
                        <tree>
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="document_number"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="verified" widget="boolean_toggle"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </page>

            <!-- Add Pre-qualification Checklist Tab -->
            <page string="Documents" position="after">
                <page string="Pre-qualification Checklist" name="checklist">
                    <group>
                        <field name="checklist_completed" widget="boolean"/>
                    </group>
                    <field name="checklist_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="completed" widget="boolean_toggle"/>
                            <field name="completed_by_id"/>
                            <field name="completed_date"/>
                            <field name="remarks"/>
                        </tree>
                    </field>
                </page>
            </page>

            <!-- Add Onboarding & Approval Tab -->
            <page string="Pre-qualification Checklist" position="after">
                <page string="Onboarding &amp; Approval" name="onboarding" groups="vendor_management.group_vendor_manager">
                    <group>
                        <group>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="portal_user_id"/>
                        </group>
                    </group>
                    <group invisible="status != 'rejected'">
                        <field name="rejection_reason"/>
                    </group>
                </page>
            </page>

            <!-- Add Financial Tab -->
            <page string="Onboarding &amp; Approval" position="after">
                <page string="Financial" name="financial">
                    <group>
                        <group string="Credit &amp; Payments">
                            <field name="credit_limit" widget="monetary"/>
                            <field name="pending_payment" widget="monetary" readonly="1"/>
                            <field name="total_purchases" widget="monetary" readonly="1"/>
                        </group>
                        <group string="Statistics">
                            <field name="purchase_count" readonly="1"/>
                            <field name="last_purchase_date" readonly="1"/>
                            <field name="rejection_rate" readonly="1"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
