<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GRN Form View -->
    <record id="view_vendor_grn_form" model="ir.ui.view">
        <field name="name">vendor.grn.form</field>
        <field name="model">vendor.grn</field>
        <field name="arch" type="xml">
            <form string="Goods Receipt Note">
                <header>
                    <button name="action_confirm_receipt" string="Confirm Receipt" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_accept" string="Accept" type="object"
                            invisible="state != 'under_inspection'" class="oe_highlight"/>
                    <button name="action_partial_accept" string="Partial Accept" type="object"
                            invisible="state != 'under_inspection'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'under_inspection'" class="btn-danger"/>
                    <button name="action_create_ncr" string="Create NCR" type="object"
                            invisible="state not in ['under_inspection', 'accepted', 'partial']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,under_inspection,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_vendor_ncr)d" type="action" class="oe_stat_button" icon="fa-warning"
                                context="{'search_default_grn_id': active_id}">
                            <field name="ncr_count" widget="statinfo" string="NCRs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="po_id" readonly="state != 'draft'"/>
                            <field name="date_received"/>
                            <field name="received_by_id"/>
                        </group>
                        <group>
                            <field name="delivery_challan_no"/>
                            <field name="vehicle_number"/>
                            <field name="transporter_name"/>
                            <field name="inspection_required"/>
                            <field name="inspection_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipt Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="po_line_id" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="description" readonly="1"/>
                                    <field name="quantity_ordered" readonly="1"/>
                                    <field name="quantity_received"/>
                                    <field name="quantity_accepted"/>
                                    <field name="quantity_rejected"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Inspection" name="inspection" invisible="not inspection_required">
                            <group>
                                <field name="inspection_report_id"/>
                                <field name="inspection_remarks" placeholder="Inspection findings and remarks..."/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- GRN Tree View -->
    <record id="view_vendor_grn_tree" model="ir.ui.view">
        <field name="name">vendor.grn.tree</field>
        <field name="model">vendor.grn</field>
        <field name="arch" type="xml">
            <tree string="GRNs" sample="1" decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="po_id"/>
                <field name="date_received"/>
                <field name="inspection_status" optional="show"/>
                <field name="ncr_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'under_inspection'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- GRN Action -->
    <record id="action_vendor_grn" model="ir.actions.act_window">
        <field name="name">Goods Receipt Notes</field>
        <field name="res_model">vendor.grn</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No GRNs recorded yet
            </p>
        </field>
    </record>

    <!-- NCR Form View -->
    <record id="view_vendor_ncr_form" model="ir.ui.view">
        <field name="name">vendor.ncr.form</field>
        <field name="model">vendor.ncr</field>
        <field name="arch" type="xml">
            <form string="Non-Conformance Report">
                <header>
                    <button name="action_report" string="Report" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_notify_vendor" string="Notify Vendor" type="object"
                            invisible="state != 'reported'" class="oe_highlight"/>
                    <button name="action_in_progress" string="In Progress" type="object"
                            invisible="state != 'vendor_notified'"/>
                    <button name="action_resolve" string="Mark Resolved" type="object"
                            invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'resolved'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="reported,vendor_notified,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="po_id"/>
                            <field name="grn_id"/>
                            <field name="date_reported"/>
                            <field name="reported_by_id"/>
                        </group>
                        <group>
                            <field name="ncr_type"/>
                            <field name="defect_category"/>
                            <field name="product_id"/>
                            <field name="quantity_rejected"/>
                            <field name="uom_id"/>
                            <field name="financial_impact" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Details" name="details">
                            <group>
                                <field name="description" placeholder="Detailed description of the issue..."/>
                                <field name="root_cause" placeholder="Root cause analysis..."/>
                                <field name="corrective_action" placeholder="Corrective action required..."/>
                            </group>
                        </page>
                        <page string="Vendor Response" name="response">
                            <group>
                                <field name="vendor_response" placeholder="Vendor's response..."/>
                                <field name="vendor_response_date"/>
                            </group>
                        </page>
                        <page string="Resolution" name="resolution">
                            <group>
                                <field name="resolution" placeholder="Resolution details..."/>
                                <field name="resolved_by_id"/>
                                <field name="resolved_date"/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- NCR Tree View -->
    <record id="view_vendor_ncr_tree" model="ir.ui.view">
        <field name="name">vendor.ncr.tree</field>
        <field name="model">vendor.ncr</field>
        <field name="arch" type="xml">
            <tree string="NCRs" sample="1" decoration-danger="defect_category == 'critical'" decoration-warning="defect_category == 'major'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="date_reported"/>
                <field name="ncr_type"/>
                <field name="defect_category" widget="badge"
                       decoration-danger="defect_category == 'critical'"
                       decoration-warning="defect_category == 'major'"
                       decoration-info="defect_category == 'minor'"/>
                <field name="product_id"/>
                <field name="quantity_rejected"/>
                <field name="financial_impact" widget="monetary" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ['reported', 'vendor_notified', 'in_progress']"
                       decoration-success="state in ['resolved', 'closed']"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- NCR Search View -->
    <record id="view_vendor_ncr_search" model="ir.ui.view">
        <field name="name">vendor.ncr.search</field>
        <field name="model">vendor.ncr</field>
        <field name="arch" type="xml">
            <search string="NCRs">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="product_id"/>
                <separator/>
                <filter string="Critical" name="filter_critical" domain="[('defect_category', '=', 'critical')]"/>
                <filter string="Major" name="filter_major" domain="[('defect_category', '=', 'major')]"/>
                <filter string="Open" name="filter_open" domain="[('state', 'in', ['reported', 'vendor_notified', 'in_progress'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="NCR Type" name="group_type" context="{'group_by': 'ncr_type'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'defect_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- NCR Action -->
    <record id="action_vendor_ncr" model="ir.actions.act_window">
        <field name="name">Non-Conformance Reports</field>
        <field name="res_model">vendor.ncr</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No NCRs reported yet
            </p>
            <p>
                Track quality issues and non-conformances from vendors.
            </p>
        </field>
    </record>
</odoo>
