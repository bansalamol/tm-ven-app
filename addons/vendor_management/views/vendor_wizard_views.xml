<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendor Rejection Wizard -->
    <record id="view_vendor_reject_wizard_form" model="ir.ui.view">
        <field name="name">vendor.reject.wizard.form</field>
        <field name="model">vendor.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Vendor">
                <group>
                    <field name="vendor_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Please provide reason for rejection..."/>
                </group>
                <footer>
                    <button string="Reject" name="action_reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Invoice Rejection Wizard -->
    <record id="view_vendor_invoice_reject_wizard_form" model="ir.ui.view">
        <field name="name">vendor.invoice.reject.wizard.form</field>
        <field name="model">vendor.invoice.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Invoice">
                <group>
                    <field name="invoice_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Please provide reason for rejection..."/>
                </group>
                <footer>
                    <button string="Reject" name="action_reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Quotation Comparison Wizard -->
    <record id="view_vendor_quotation_comparison_wizard_form" model="ir.ui.view">
        <field name="name">vendor.quotation.comparison.wizard.form</field>
        <field name="model">vendor.quotation.comparison.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare Quotations">
                <group>
                    <field name="rfq_id" readonly="1"/>
                    <field name="quotation_ids" widget="many2many_tags"/>
                </group>
                <field name="comparison_line_ids">
                    <tree>
                        <field name="product_id"/>
                        <field name="description"/>
                        <field name="vendor_id"/>
                        <field name="unit_price"/>
                        <field name="subtotal"/>
                        <field name="delivery_lead_time"/>
                    </tree>
                </field>
                <footer>
                    <button string="Generate Report" name="action_generate_report" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
