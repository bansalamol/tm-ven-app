<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendor Rating Form View -->
    <record id="view_vendor_rating_form" model="ir.ui.view">
        <field name="name">vendor.rating.form</field>
        <field name="model">vendor.rating</field>
        <field name="arch" type="xml">
            <form string="Vendor Rating">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="vendor_id" placeholder="Select Vendor" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="rating_date" readonly="state != 'draft'"/>
                            <field name="rated_by_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="overall_rating" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Rating Criteria">
                        <group>
                            <field name="quality_rating" widget="radio" readonly="state != 'draft'"/>
                            <field name="delivery_rating" widget="radio" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="service_rating" widget="radio" readonly="state != 'draft'"/>
                            <field name="pricing_rating" widget="radio" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Additional comments about this rating..."
                               readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vendor Rating Tree View -->
    <record id="view_vendor_rating_tree" model="ir.ui.view">
        <field name="name">vendor.rating.tree</field>
        <field name="model">vendor.rating</field>
        <field name="arch" type="xml">
            <tree string="Vendor Ratings" sample="1" decoration-muted="state == 'cancelled'">
                <field name="rating_date"/>
                <field name="vendor_id"/>
                <field name="quality_rating" widget="badge"/>
                <field name="delivery_rating" widget="badge"/>
                <field name="service_rating" widget="badge"/>
                <field name="pricing_rating" widget="badge"/>
                <field name="overall_rating" widget="progressbar"/>
                <field name="rated_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Vendor Rating Kanban View -->
    <record id="view_vendor_rating_kanban" model="ir.ui.view">
        <field name="name">vendor.rating.kanban</field>
        <field name="model">vendor.rating</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="vendor_id"/>
                <field name="rating_date"/>
                <field name="overall_rating"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="vendor_id"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="rating_date"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    Overall Rating: <field name="overall_rating" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'confirmed': 'success', 'draft': 'info',
                                                                 'cancelled': 'default'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vendor Rating Search View -->
    <record id="view_vendor_rating_search" model="ir.ui.view">
        <field name="name">vendor.rating.search</field>
        <field name="model">vendor.rating</field>
        <field name="arch" type="xml">
            <search string="Vendor Ratings">
                <field name="vendor_id"/>
                <field name="rated_by_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('rating_date', '&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('rating_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <filter string="This Year" name="filter_this_year"
                        domain="[('rating_date', '&gt;=', context_today().strftime('%Y-01-01')),
                                 ('rating_date', '&lt;', (context_today() + relativedelta(years=1)).strftime('%Y-01-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Rating Date" name="group_rating_date" context="{'group_by': 'rating_date'}"/>
                    <filter string="Rated By" name="group_rated_by" context="{'group_by': 'rated_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vendor Rating Action -->
    <record id="action_vendor_rating" model="ir.actions.act_window">
        <field name="name">Vendor Ratings</field>
        <field name="res_model">vendor.rating</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vendor rating
            </p>
            <p>
                Rate and evaluate vendor performance on quality, delivery, service, and pricing.
            </p>
        </field>
    </record>
</odoo>
