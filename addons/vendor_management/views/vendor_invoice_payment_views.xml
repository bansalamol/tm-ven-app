<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Form View -->
    <record id="view_vendor_invoice_form" model="ir.ui.view">
        <field name="name">vendor.invoice.form</field>
        <field name="model">vendor.invoice</field>
        <field name="arch" type="xml">
            <form string="Vendor Invoice">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_verify" string="Verify" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"
                            groups="vendor_management.group_vendor_manager"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'verified'" class="oe_highlight"
                            groups="vendor_management.group_vendor_manager"/>
                    <button name="action_create_payment" string="Register Payment" type="object"
                            invisible="state != 'approved'" class="oe_highlight"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ['submitted', 'verified']"
                            groups="vendor_management.group_vendor_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,verified,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="vendor_invoice_number" readonly="state != 'draft'"/>
                            <field name="po_id"/>
                            <field name="grn_id"/>
                        </group>
                        <group>
                            <field name="date_invoice" readonly="state != 'draft'"/>
                            <field name="date_due" readonly="state != 'draft'"/>
                            <field name="date_received"/>
                            <field name="payment_term_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                <field name="amount_paid" widget="monetary"/>
                                <field name="amount_due" widget="monetary" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Approval" name="approval" groups="vendor_management.group_vendor_manager">
                            <group>
                                <field name="verified_by_id"/>
                                <field name="approved_by_id"/>
                                <field name="rejection_reason" invisible="state != 'rejected'"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Invoice Tree View -->
    <record id="view_vendor_invoice_tree" model="ir.ui.view">
        <field name="name">vendor.invoice.tree</field>
        <field name="model">vendor.invoice</field>
        <field name="arch" type="xml">
            <tree string="Invoices" sample="1" decoration-success="state == 'paid'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="vendor_invoice_number"/>
                <field name="vendor_id"/>
                <field name="date_invoice"/>
                <field name="date_due"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="amount_due" widget="monetary" sum="Due"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-warning="state in ['verified', 'approved']"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Invoice Search View -->
    <record id="view_vendor_invoice_search" model="ir.ui.view">
        <field name="name">vendor.invoice.search</field>
        <field name="model">vendor.invoice</field>
        <field name="arch" type="xml">
            <search string="Invoices">
                <field name="name"/>
                <field name="vendor_invoice_number"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="To Verify" name="filter_to_verify" domain="[('state', '=', 'submitted')]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', '=', 'verified')]"/>
                <filter string="To Pay" name="filter_to_pay" domain="[('state', '=', 'approved')]"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('date_due', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '!=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Invoice Date" name="group_date" context="{'group_by': 'date_invoice'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Invoice Action -->
    <record id="action_vendor_invoice" model="ir.actions.act_window">
        <field name="name">Vendor Invoices</field>
        <field name="res_model">vendor.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_to_verify': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices submitted yet
            </p>
        </field>
    </record>

    <!-- Payment Form View -->
    <record id="view_vendor_payment_form" model="ir.ui.view">
        <field name="name">vendor.payment.form</field>
        <field name="model">vendor.payment</field>
        <field name="arch" type="xml">
            <form string="Vendor Payment">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"
                            groups="vendor_management.group_vendor_manager"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            invisible="state != 'approved'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['paid', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="invoice_id"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method"/>
                            <field name="payment_reference"/>
                            <field name="bank_account_id" domain="[('vendor_id', '=', vendor_id)]"/>
                        </group>
                    </group>
                    <group string="Approval" invisible="state == 'draft'" groups="vendor_management.group_vendor_manager">
                        <field name="approved_by_id"/>
                        <field name="approved_date"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes or transaction details..."/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payment Tree View -->
    <record id="view_vendor_payment_tree" model="ir.ui.view">
        <field name="name">vendor.payment.tree</field>
        <field name="model">vendor.payment</field>
        <field name="arch" type="xml">
            <tree string="Payments" sample="1" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="invoice_id"/>
                <field name="payment_date"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="payment_method"/>
                <field name="payment_reference"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state in ['rejected', 'cancelled']"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Payment Search View -->
    <record id="view_vendor_payment_search" model="ir.ui.view">
        <field name="name">vendor.payment.search</field>
        <field name="model">vendor.payment</field>
        <field name="arch" type="xml">
            <search string="Payments">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="invoice_id"/>
                <separator/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('payment_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Payment Method" name="group_method" context="{'group_by': 'payment_method'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Payment Action -->
    <record id="action_vendor_payment" model="ir.actions.act_window">
        <field name="name">Vendor Payments</field>
        <field name="res_model">vendor.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payments recorded yet
            </p>
        </field>
    </record>
</odoo>
