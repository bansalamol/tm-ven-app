<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RFQ Form View -->
    <record id="view_vendor_rfq_form" model="ir.ui.view">
        <field name="name">vendor.rfq.form</field>
        <field name="model">vendor.rfq</field>
        <field name="arch" type="xml">
            <form string="Request for Quotation">
                <header>
                    <button name="action_send_to_vendors" string="Send to Vendors" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_compare_quotations" string="Compare Quotations" type="object"
                            invisible="state not in ['quoted', 'evaluated']" class="oe_highlight"/>
                    <button name="action_create_po" string="Create PO" type="object"
                            invisible="state != 'awarded'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['awarded', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,quoted,evaluated,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_created"/>
                            <field name="deadline" required="1"/>
                            <field name="requested_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="department_id"/>
                            <field name="vendor_count"/>
                            <field name="awarded_vendor_id" invisible="state != 'awarded'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vendors" name="vendors">
                            <field name="vendor_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </page>
                        <page string="Items" name="items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="delivery_date_required"/>
                                    <field name="specifications"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description &amp; Terms" name="description">
                            <group>
                                <field name="description" placeholder="Detailed description of requirements..."/>
                                <field name="technical_specifications" placeholder="Technical specifications and requirements..."/>
                                <field name="terms_conditions" placeholder="Terms and conditions..."/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- RFQ Tree View -->
    <record id="view_vendor_rfq_tree" model="ir.ui.view">
        <field name="name">vendor.rfq.tree</field>
        <field name="model">vendor.rfq</field>
        <field name="arch" type="xml">
            <tree string="RFQs" sample="1" decoration-info="state == 'draft'" decoration-success="state == 'awarded'">
                <field name="name"/>
                <field name="date_created"/>
                <field name="deadline"/>
                <field name="requested_by_id"/>
                <field name="category_id"/>
                <field name="vendor_count"/>
                <field name="quotation_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'sent'"
                       decoration-warning="state in ['quoted', 'evaluated']"
                       decoration-success="state == 'awarded'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- RFQ Kanban View -->
    <record id="view_vendor_rfq_kanban" model="ir.ui.view">
        <field name="name">vendor.rfq.kanban</field>
        <field name="model">vendor.rfq</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="date_created"/>
                <field name="deadline"/>
                <field name="state"/>
                <field name="vendor_count"/>
                <field name="quotation_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        Deadline: <field name="deadline"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-users"/> <field name="vendor_count"/> Vendors
                                </div>
                                <div>
                                    <i class="fa fa-file-text-o"/> <field name="quotation_count"/> Quotations
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'info', 'sent': 'primary',
                                                                 'quoted': 'warning', 'awarded': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- RFQ Search View -->
    <record id="view_vendor_rfq_search" model="ir.ui.view">
        <field name="name">vendor.rfq.search</field>
        <field name="model">vendor.rfq</field>
        <field name="arch" type="xml">
            <search string="RFQs">
                <field name="name"/>
                <field name="vendor_ids"/>
                <field name="category_id"/>
                <field name="requested_by_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Quoted" name="filter_quoted" domain="[('state', '=', 'quoted')]"/>
                <filter string="Awarded" name="filter_awarded" domain="[('state', '=', 'awarded')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date_created', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Requested By" name="group_requester" context="{'group_by': 'requested_by_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- RFQ Action -->
    <record id="action_vendor_rfq" model="ir.actions.act_window">
        <field name="name">Requests for Quotation</field>
        <field name="res_model">vendor.rfq</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first RFQ
            </p>
            <p>
                Send requests for quotation to multiple vendors and compare their responses.
            </p>
        </field>
    </record>
</odoo>
