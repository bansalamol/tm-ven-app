<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form View -->
    <record id="view_vendor_purchase_order_form" model="ir.ui.view">
        <field name="name">vendor.purchase.order.form</field>
        <field name="model">vendor.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                <header>
                    <button name="action_send_to_vendor" string="Send to Vendor" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state != 'sent'" class="oe_highlight"/>
                    <button name="action_receive" string="Receive Goods" type="object"
                            invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['paid', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,confirmed,received,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_grns" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="grn_count" widget="statinfo" string="GRNs"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="rfq_id" readonly="1"/>
                            <field name="quotation_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="date_planned"/>
                            <field name="date_delivered" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="qty_received" readonly="1" optional="show"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Terms &amp; Conditions" name="terms">
                            <group>
                                <field name="payment_term_id"/>
                                <field name="notes" placeholder="Terms and conditions..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Purchase Order Tree View -->
    <record id="view_vendor_purchase_order_tree" model="ir.ui.view">
        <field name="name">vendor.purchase.order.tree</field>
        <field name="model">vendor.purchase.order</field>
        <field name="arch" type="xml">
            <tree string="Purchase Orders" sample="1" decoration-info="state == 'draft'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="date_order"/>
                <field name="date_planned"/>
                <field name="date_delivered" optional="hide"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="grn_count" optional="show"/>
                <field name="invoice_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'sent'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Purchase Order Kanban View -->
    <record id="view_vendor_purchase_order_kanban" model="ir.ui.view">
        <field name="name">vendor.purchase.order.kanban</field>
        <field name="model">vendor.purchase.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="date_order"/>
                <field name="amount_total"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="vendor_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <field name="date_order"/>
                                </div>
                                <div>
                                    <strong><field name="amount_total" widget="monetary"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'confirmed': 'warning', 'paid': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Purchase Order Search View -->
    <record id="view_vendor_purchase_order_search" model="ir.ui.view">
        <field name="name">vendor.purchase.order.search</field>
        <field name="model">vendor.purchase.order</field>
        <field name="arch" type="xml">
            <search string="Purchase Orders">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="rfq_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Received" name="filter_received" domain="[('state', '=', 'received')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date_order', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Order Date" name="group_date" context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Purchase Order Action -->
    <record id="action_vendor_purchase_order" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">vendor.purchase.order</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Purchase Order
            </p>
            <p>
                Track purchase orders and their fulfillment status.
            </p>
        </field>
    </record>
</odoo>
