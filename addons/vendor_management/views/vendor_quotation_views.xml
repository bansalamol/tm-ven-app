<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Form View -->
    <record id="view_vendor_quotation_form" model="ir.ui.view">
        <field name="name">vendor.quotation.form</field>
        <field name="model">vendor.quotation</field>
        <field name="arch" type="xml">
            <form string="Vendor Quotation">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_start_evaluation" string="Start Evaluation" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_complete_evaluation" string="Complete Evaluation" type="object"
                            invisible="evaluation_status != 'in_progress'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_evaluation,awarded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="rfq_id" readonly="state != 'draft'"/>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="date_submitted" readonly="1"/>
                        </group>
                        <group>
                            <field name="valid_until"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="evaluation_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quotation Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="rfq_line_id" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="description" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="delivery_lead_time"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Terms &amp; Conditions" name="terms">
                            <group>
                                <field name="payment_terms" placeholder="Payment terms..."/>
                                <field name="delivery_terms" placeholder="Delivery terms and conditions..."/>
                                <field name="warranty_terms" placeholder="Warranty and after-sales terms..."/>
                                <field name="notes" placeholder="Additional notes or remarks..."/>
                            </group>
                        </page>
                        <page string="Evaluation" name="evaluation" groups="vendor_management.group_vendor_manager">
                            <group string="Technical Evaluation">
                                <field name="technical_score" widget="progressbar"/>
                                <field name="technical_remarks" placeholder="Technical evaluation remarks..."/>
                            </group>
                            <group string="Commercial Evaluation">
                                <field name="commercial_score" widget="progressbar"/>
                                <field name="commercial_remarks" placeholder="Commercial evaluation remarks..."/>
                            </group>
                            <group string="Overall">
                                <field name="overall_score" widget="progressbar"/>
                                <field name="evaluated_by_id"/>
                                <field name="evaluation_date"/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Quotation Tree View -->
    <record id="view_vendor_quotation_tree" model="ir.ui.view">
        <field name="name">vendor.quotation.tree</field>
        <field name="model">vendor.quotation</field>
        <field name="arch" type="xml">
            <tree string="Quotations" sample="1" decoration-success="state == 'awarded'" decoration-muted="state in ['lost', 'cancelled']">
                <field name="name"/>
                <field name="rfq_id"/>
                <field name="vendor_id"/>
                <field name="date_submitted"/>
                <field name="valid_until"/>
                <field name="total_amount" widget="monetary"/>
                <field name="overall_score" widget="progressbar" optional="show"/>
                <field name="evaluation_status" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-warning="state == 'under_evaluation'"
                       decoration-success="state == 'awarded'"
                       decoration-muted="state in ['lost', 'cancelled']"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Quotation Kanban View -->
    <record id="view_vendor_quotation_kanban" model="ir.ui.view">
        <field name="name">vendor.quotation.kanban</field>
        <field name="model">vendor.quotation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="total_amount"/>
                <field name="state"/>
                <field name="overall_score"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="vendor_id"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    Amount: <field name="total_amount" widget="monetary"/>
                                </div>
                                <div t-if="record.overall_score.raw_value">
                                    Score: <field name="overall_score"/> / 100
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'awarded': 'success', 'lost': 'default'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Quotation Search View -->
    <record id="view_vendor_quotation_search" model="ir.ui.view">
        <field name="name">vendor.quotation.search</field>
        <field name="model">vendor.quotation</field>
        <field name="arch" type="xml">
            <search string="Quotations">
                <field name="name"/>
                <field name="rfq_id"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Evaluation" name="filter_evaluation" domain="[('state', '=', 'under_evaluation')]"/>
                <filter string="Awarded" name="filter_awarded" domain="[('state', '=', 'awarded')]"/>
                <separator/>
                <filter string="High Score (&gt;80)" name="filter_high_score" domain="[('overall_score', '&gt;=', 80)]"/>
                <group expand="0" string="Group By">
                    <filter string="RFQ" name="group_rfq" context="{'group_by': 'rfq_id'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Quotation Action -->
    <record id="action_vendor_quotation" model="ir.actions.act_window">
        <field name="name">Vendor Quotations</field>
        <field name="res_model">vendor.quotation</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_filter_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No quotations yet
            </p>
            <p>
                Quotations are received from vendors in response to RFQs.
            </p>
        </field>
    </record>
</odoo>
