<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Vendor Code Sequence -->
        <record id="seq_vendor_vendor" model="ir.sequence">
            <field name="name">Vendor Code</field>
            <field name="code">vendor.vendor</field>
            <field name="prefix">VEN</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- RFQ Sequence -->
        <record id="seq_vendor_rfq" model="ir.sequence">
            <field name="name">RFQ Number</field>
            <field name="code">vendor.rfq</field>
            <field name="prefix">RFQ</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Purchase Order Sequence -->
        <record id="seq_vendor_purchase_order" model="ir.sequence">
            <field name="name">Purchase Order Number</field>
            <field name="code">vendor.purchase.order</field>
            <field name="prefix">PO</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- GRN Sequence -->
        <record id="seq_vendor_grn" model="ir.sequence">
            <field name="name">GRN Number</field>
            <field name="code">vendor.grn</field>
            <field name="prefix">GRN</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- NCR Sequence -->
        <record id="seq_vendor_ncr" model="ir.sequence">
            <field name="name">NCR Number</field>
            <field name="code">vendor.ncr</field>
            <field name="prefix">NCR</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Inspection Report Sequence -->
        <record id="seq_vendor_inspection_report" model="ir.sequence">
            <field name="name">Inspection Report Number</field>
            <field name="code">vendor.inspection.report</field>
            <field name="prefix">INS</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Payment Sequence -->
        <record id="seq_vendor_payment" model="ir.sequence">
            <field name="name">Payment Reference</field>
            <field name="code">vendor.payment</field>
            <field name="prefix">PAY</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
